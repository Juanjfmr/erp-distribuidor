rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: busca o perfil do usuário autenticado
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: verifica se o usuário pertence ao tenant
    function belongsToCompany(companyId) {
      return request.auth != null
          && userProfile().companyId == companyId
          && userProfile().active == true;
    }

    function tenantRole() {
      return userProfile().role;
    }

    function canEdit(companyId) {
      return belongsToCompany(companyId) && tenantRole() in ['admin', 'vendedor'];
    }

    function canAdmin(companyId) {
      return belongsToCompany(companyId) && tenantRole() == 'admin';
    }

    function supportedCollection(collection) {
      return collection in ['products', 'clients', 'suppliers', 'invoices',
          'purchases', 'receivables', 'payables', 'transactions',
          'stockMovements', 'orders', 'returns', 'pdv_sessions'];
    }

    // Helper: retorna o plano ativo da empresa
    function companyPlan(companyId) {
      return get(/databases/$(database)/documents/empresas/$(companyId)).data.plan;
    }

    // Helper: verifica se o plano da empresa atinge o nível exigido
    // Níveis: 'basic' ≤ 'pro' ≤ 'enterprise'
    function hasPlan(companyId, required) {
      let plan = companyPlan(companyId);
      return required == 'basic'
          || (required == 'pro'        && plan in ['profissional', 'empresarial', 'owner'])
          || (required == 'enterprise' && plan in ['empresarial', 'owner']);
    }

    // Coleções que exigem plano acima do básico (mapeadas aos módulos do frontend)
    // 'pro':        devolucoes, relatorios, comissoes, tabelaPreco, estoqueMin
    // 'enterprise': pdv, api
    function requiresPro(collection) {
      return collection == 'returns';
    }

    function requiresEnterprise(collection) {
      return collection == 'pdv_sessions';
    }

    // Helper: superadmin da instância
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'juanjfmr1@gmail.com';
    }

    // ── Dados da empresa (single-document por tenant) ──────────────────────
    match /empresas/{companyId} {
      allow read: if belongsToCompany(companyId) || isSuperAdmin();

      // Cadastro da propria empresa: nunca permitir escolher tenant, plano ou status.
      allow create: if request.auth != null
        && request.auth.uid == companyId
        && canAdmin(companyId)
        && request.resource.data.keys().hasOnly(['name','plan','trialEndsAt','active','createdAt','company'])
        && request.resource.data.plan == 'trial'
        && request.resource.data.active == true;

      // Plano, trial, status e ativacao so podem mudar pelo backend administrativo.
      allow update: if canEdit(companyId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['company','updatedAt','lastNFSeq','onboarding'])
        && (canAdmin(companyId) ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['company','onboarding']));

      allow delete: if false;
    }

    // ── Configuração global da instância ──────────────────────────────────
    match /config/{docId} {
      // Contem configuracoes globais e possivelmente segredos: tenant admin nao e superadmin.
      allow read, write: if isSuperAdmin();
    }

    // ── Usuários ───────────────────────────────────────────────────────────
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid
        || (request.auth != null && tenantRole() == 'admin'
          && userProfile().active == true
          && resource.data.companyId == userProfile().companyId);

      // Consultas de usuarios exigem query por companyId no cliente.
      allow list: if request.auth != null
        && userProfile().active == true
        && tenantRole() == 'admin'
        && resource.data.companyId == userProfile().companyId;

      // Primeiro registro: conta propria cria sua propria empresa, nunca escolhe outra.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.companyId == request.auth.uid
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['name','email','role','active','createdAt','companyId']);

      // Admin da empresa pode convidar usuarios apenas para o proprio tenant.
      allow create: if request.auth != null
        && request.auth.uid != uid
        && userProfile().active == true
        && tenantRole() == 'admin'
        && request.resource.data.companyId == userProfile().companyId
        && request.resource.data.role in ['admin','vendedor','visualizador','contador'];

      // Usuarios podem atualizar seu proprio nome; nao podem elevar role nem trocar tenant.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      // Alteracoes administrativas conservam o tenant e identificador de login.
      allow update: if request.auth != null
        && userProfile().active == true
        && tenantRole() == 'admin'
        && resource.data.companyId == userProfile().companyId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.email == resource.data.email
        && request.resource.data.role in ['admin','vendedor','visualizador','contador']
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name','role','active','isExternal']);
      allow delete: if false;
    }

    // ── Subcoleções por módulo ─────────────────────────────────────────────
    match /empresas/{companyId}/{collection}/{docId} {
      allow read: if supportedCollection(collection) && belongsToCompany(companyId);

      // Visualizador/contador nao podem escrever, mesmo chamando SDK diretamente.
      allow write: if supportedCollection(collection)
        && canEdit(companyId)
        && (!requiresPro(collection) || hasPlan(companyId, 'pro'))
        && (!requiresEnterprise(collection) || hasPlan(companyId, 'enterprise'));
    }

    // ── Pagamentos (coleção raiz — lida pelo painel admin) ────────────────
    match /pagamentos/{docId} {
      // Leitura: apenas superadmin
      allow read: if request.auth != null
        && request.auth.token.email == 'juanjfmr1@gmail.com';
      // Escrita: bloqueada no client — só Cloud Functions (Admin SDK) gravam
      allow write: if false;
    }

    // ── Bloqueia tudo que não foi explicitamente permitido ─────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# ─── MiniMax (primary worker) ────────────────────────────────────────────────
# Get your key at: https://platform.minimax.io
MINIMAX_API_KEY=your_minimax_key_here

# Verify the exact model name in your MiniMax dashboard
# Common values: MiniMax-M3, minimax-m3
MINIMAX_MODEL=MiniMax-M3

# Optional: cheaper/faster model for simple tasks (format, rename, extract, list)
# If not set, all tasks use MINIMAX_MODEL
# MINIMAX_MODEL_SIMPLE=minimax-m3-mini

# Use minimaxi.com for China-based access
MINIMAX_BASE_URL=https://api.minimax.io/v1

# ─── DeepSeek (fallback — optional) ──────────────────────────────────────────
# Used automatically when MiniMax returns 429/5xx or times out.
# NOT used for 4xx client errors (wrong model name, bad key, etc.)
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Requests per minute (MiniMax M3 hard limit is 200 — keep margin)
MAX_RPM=190

# Max parallel workers active at once
MAX_CONCURRENT=40

# ─── Timeouts & limits ────────────────────────────────────────────────────────
# How long to wait for a single API response before aborting (ms)
FETCH_TIMEOUT_MS=60000

# Max file size accepted by summarize_file (bytes)
MAX_FILE_SIZE_BYTES=512000

# ─── Cache ────────────────────────────────────────────────────────────────────
# Directory for cache.json and usage.log
# Defaults to ~/.cache/mcp-workers on all platforms
# CACHE_DIR=C:\Users\SEU_USUARIO\.cache\mcp-workers

# Max number of entries kept in cache (LRU eviction when full)
CACHE_MAX_ENTRIES=500

# ─── MiniMax (primary worker) ────────────────────────────────────────────────
# Get your key at: https://platform.minimax.io
MINIMAX_API_KEY=your_minimax_key_here

# Verify the exact model name in your MiniMax dashboard
# Common values: MiniMax-M3, minimax-m3
MINIMAX_MODEL=MiniMax-M3

# Use minimaxi.com for China-based access
MINIMAX_BASE_URL=https://api.minimax.io/v1

# ─── DeepSeek (fallback — optional) ──────────────────────────────────────────
# When set, DeepSeek is used automatically if MiniMax returns 429/5xx or times out.
# It is NOT used for 4xx client errors (wrong model name, bad key, etc.)
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Requests per minute sent to MiniMax (hard limit is 200 — keep margin below)
MAX_RPM=190

# Max parallel workers per swarm batch
MAX_CONCURRENT=40

# ─── Timeouts & limits ───────────────────────────────────────────────────────
# How long to wait for a single API response before aborting (milliseconds)
FETCH_TIMEOUT_MS=60000

# Max file size accepted by summarize_file before refusing (bytes)
MAX_FILE_SIZE_BYTES=512000

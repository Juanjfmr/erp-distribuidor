# ─── MiniMax (primary worker) ────────────────────────────────────────────────
# Get your key at: https://platform.minimax.io
MINIMAX_API_KEY=your_minimax_key_here

# Model name — verify the exact name in your MiniMax dashboard
# Common values: MiniMax-M3, minimax-m3, abab6.5s-chat
MINIMAX_MODEL=MiniMax-M3

# API base URL (use minimaxi.com for China-based access)
MINIMAX_BASE_URL=https://api.minimax.io/v1

# ─── DeepSeek (fallback — optional) ──────────────────────────────────────────
# If set, DeepSeek will be used when MiniMax fails or is rate-limited
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Requests per minute (MiniMax M3 limit is 200 — keep margin below)
MAX_RPM=190

# Max parallel workers per swarm batch
MAX_CONCURRENT=40

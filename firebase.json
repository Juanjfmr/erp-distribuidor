{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "CLAUDE.md",
      "PRIORIZACAO.md",
      "serve.py",
      "scripts/**",
      "docs/**",
      "wiki/**",
      ".claude/**",
      ".obsidian/**",
      "node_modules/**",
      "0",
      "Estas",
      "c.checked"
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
